---
import Base from '../layouts/Base.astro';
import { allPeople } from '../lib/people';
import { chronologicalYear } from '../data/learning';
const people=await allPeople();
const entries=people.flatMap(p=>p.data.discoveries.map((d,i)=>({person:p,idea:d,index:i}))).sort((a,b)=>a.idea.title.localeCompare(b.idea.title));
const fields=[...new Set(people.flatMap(p=>p.data.fields))].sort();
---
<Base title="Discoveries & ideas" description="Search scientific discoveries, mathematical methods, and philosophical arguments across the Pantheon catalogue.">
 <section class="shell page-intro"><p class="eyebrow">THE IDEA INDEX / {entries.length} CONTRIBUTIONS</p><h1>Follow the idea.<br/><em>Find the mind behind it.</em></h1><p>From atoms and algorithms to justice and the self. Search across the catalogue, then open the original profile for context, qualifications, and sources.</p></section>
 <section class="shell" id="idea-index">
  <div class="directory-panel"><label class="directory-search"><span aria-hidden="true">⌕</span><span class="sr-only">Search discoveries and ideas</span><input id="idea-search" type="search" placeholder="Try: quantum, justice, geometry, DNA…"/></label><div class="directory-filters"><label>Discipline<select id="idea-category" class="filter-select"><option value="all">Science & philosophy</option><option value="scientist">Science & mathematics</option><option value="philosopher">Philosophy</option></select></label><label>Field<select id="idea-field" class="filter-select"><option value="all">All fields</option>{fields.map(f=><option value={f}>{f}</option>)}</select></label><label>Order<select id="idea-sort" class="filter-select"><option value="name">Idea A–Z</option><option value="oldest">Earliest first</option><option value="newest">Latest first</option></select></label></div><div class="directory-options"><label><input id="idea-interactive" type="checkbox"/> With an interactive experiment or argument</label><button id="idea-reset" class="inline-link">Reset filters ↺</button></div></div>
  <div class="directory-meta"><p id="idea-count" role="status" aria-live="polite">{entries.length} ideas to explore</p><a class="inline-link" href="/explore">Browse by person ↗</a></div>
  <div class="idea-grid" id="idea-grid">{entries.map(({person:p,idea:d,index})=><article class="idea-card" data-idea data-name={d.title} data-category={p.data.category} data-fields={p.data.fields.join('|')} data-year={chronologicalYear(d.year)} data-interactive={String(!!(d.argument||d.interactiveDemo))} data-search={[d.title,d.summary,d.significance,p.data.name,...p.data.fields].join(' ')}><div class="idea-card-meta"><span>{d.year}</span><span>{p.data.category==='scientist'?'SCIENCE':'PHILOSOPHY'}</span></div><h2><a href={`/p/${p.id}#discovery-${index+1}`}>{d.title} ↗</a></h2><p>{d.summary}</p><details><summary>Why it matters</summary><p>{d.significance}</p>{d.disputed&&<p>{d.disputed}</p>}</details><div class="idea-card-footer"><a href={`/p/${p.id}`}>{p.data.name}</a>{(d.argument||d.interactiveDemo)&&<span>Interactive</span>}</div></article>)}</div>
  <div class="empty-state" id="idea-empty" hidden><h2>No ideas match those filters.</h2><p>Try a broader term or reset the filters above.</p></div><div class="idea-pagination" id="idea-pagination" hidden><button class="button secondary" id="idea-more">Show more ideas ↓</button><p id="idea-shown"></p></div>
  <noscript><p>All contributions are listed below the filters. Interactive filtering requires JavaScript.</p></noscript>
 </section>
</Base>
<script>
const search=document.querySelector<HTMLInputElement>('#idea-search')!;
const category=document.querySelector<HTMLSelectElement>('#idea-category')!;
const field=document.querySelector<HTMLSelectElement>('#idea-field')!;
const sort=document.querySelector<HTMLSelectElement>('#idea-sort')!;
const interactive=document.querySelector<HTMLInputElement>('#idea-interactive')!;
const records=[...document.querySelectorAll<HTMLElement>('[data-idea]')];
const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
let limit=24;
function readUrl(){const q=new URLSearchParams(location.search);search.value=q.get('q')||'';for(const [key,el] of [['category',category],['field',field],['sort',sort]] as const){const value=q.get(key)||el.options[0]!.value;el.value=[...el.options].some(o=>o.value===value)?value:el.options[0]!.value;}interactive.checked=q.get('interactive')==='1';limit=24;}
function update(sync=true){const q=normalize(search.value);const matches=records.filter(r=>(!q||normalize(r.dataset.search!).includes(q))&&(category.value==='all'||r.dataset.category===category.value)&&(field.value==='all'||r.dataset.fields!.split('|').includes(field.value))&&(!interactive.checked||r.dataset.interactive==='true'));matches.sort((a,b)=>sort.value==='oldest'?Number(a.dataset.year)-Number(b.dataset.year):sort.value==='newest'?Number(b.dataset.year)-Number(a.dataset.year):a.dataset.name!.localeCompare(b.dataset.name!));records.forEach(r=>r.hidden=true);matches.forEach((r,i)=>{document.getElementById('idea-grid')!.append(r);r.hidden=i>=limit;});document.getElementById('idea-count')!.textContent=`${matches.length} ${matches.length===1?'idea':'ideas'} to explore`;document.getElementById('idea-empty')!.hidden=matches.length>0;document.getElementById('idea-pagination')!.hidden=matches.length===0;document.getElementById('idea-more')!.hidden=matches.length<=limit;document.getElementById('idea-shown')!.textContent=`Showing ${Math.min(limit,matches.length)} of ${matches.length}`;if(sync){const url=new URL(location.href);url.search='';if(search.value.trim())url.searchParams.set('q',search.value.trim());for(const [key,el] of [['category',category],['field',field],['sort',sort]] as const)if(el.selectedIndex>0)url.searchParams.set(key,el.value);if(interactive.checked)url.searchParams.set('interactive','1');history.replaceState(null,'',url);}}
search.addEventListener('input',()=>{limit=24;update();});for(const el of [category,field,sort,interactive])el.addEventListener('change',()=>{limit=24;update();});document.getElementById('idea-reset')!.addEventListener('click',()=>{search.value='';category.selectedIndex=field.selectedIndex=sort.selectedIndex=0;interactive.checked=false;limit=24;update();search.focus();});document.getElementById('idea-more')!.addEventListener('click',()=>{const before=limit;limit+=24;update(false);const shown=[...document.querySelectorAll<HTMLElement>('[data-idea]:not([hidden])')];shown[before]?.querySelector('a')?.focus();});window.addEventListener('popstate',()=>{readUrl();update(false);});readUrl();update(false);
</script>
