---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import SolarSystem from '../components/SolarSystem';
import { allPeople, verifyLinks } from '../lib/people';
import { allInnovations } from '../lib/ideas';
import { verifyArguments } from '../arguments/kernel/registry';
await verifyLinks(); await verifyArguments();
const people = await allPeople();
const spotlight = ['marie-curie', 'j-robert-oppenheimer', 'mary-wollstonecraft', 'br-ambedkar'].map(id => people.find(p => p.id === id)).filter(Boolean);
const innovations = await allInnovations();
const contributions = people.reduce((total, person) => total + person.data.discoveries.length, 0) + innovations.length;
const doorways = [
 { href: '/scientists', number: '01', label: 'SCIENCE', title: 'Understand the world.', text: 'Discoveries, experiments, and the people behind them.', detail: `${people.filter(p => p.data.category === 'scientist').length} scientists`, icon: '◎' },
 { href: '/philosophy', number: '02', label: 'PHILOSOPHY', title: 'Question what you know.', text: 'Compare schools of thought and examine their arguments.', detail: '75 schools & positions', icon: '∞' },
 { href: '/laboratory', number: '03', label: 'LABORATORY', title: 'Find out for yourself.', text: 'Change a variable. Make a prediction. See what follows.', detail: 'Interactive models & arguments', icon: '↗' },
];
---
<Base title="The Pantheon" description="Explore science and philosophy through sourced human stories, interactive experiments, and ideas you can take apart.">
 <div class="home-redesign">
  <section class="home-opening shell" aria-labelledby="home-title">
   <div class="home-opening-copy">
    <p class="eyebrow"><span aria-hidden="true">✳</span> A FIELD GUIDE TO HUMAN CURIOSITY</p>
    <h1 id="home-title" data-hi="Bade sawaal. Naye nazariye.">Big questions.<br/><span>Brighter perspectives.</span></h1>
    <p class="home-lede" data-hi="Duniya ko samjho. Apni soch ko sawaal karo. Science aur philosophy ke ideas ko padho, aur khud karke dekho.">Understand the world. Question your assumptions. Meet the minds behind science and philosophy, then try their ideas for yourself.</p>
    <div class="home-opening-actions"><a href="/explore" class="button primary" data-hi="Minds aur ideas khojo ↗">Explore the archive <span aria-hidden="true">↗</span></a><a href="/paths" class="button secondary">Find a starting point <span aria-hidden="true">→</span></a></div>
    <p class="home-editorial-note">Sourced stories. Playable ideas. Room for disagreement.</p>
   </div>
   <aside class="home-question-board" aria-label="Start with a question">
    <div class="question-board-top"><span class="eyebrow">START WITH A QUESTION</span><span aria-hidden="true">↘</span></div>
    <a href="/lab/matter-and-sound"><span class="question-index">01 / MATTER</span><strong>Why can’t you walk<br/>through a wall?</strong><span class="question-link">Explore matter & sound <span aria-hidden="true">↗</span></span></a>
    <a href="/philosophy/schools/stoicism"><span class="question-index">02 / LIVING</span><strong>What is actually<br/>in your control?</strong><span class="question-link">Meet the Stoics <span aria-hidden="true">↗</span></span></a>
    <div class="question-board-bottom"><span class="question-orbit" aria-hidden="true">✳</span><span>Follow a question.<br/>See where it takes you.</span></div>
   </aside>
  </section>
  <div class="home-proof shell" aria-label="Inside the archive"><p><strong>{people.length}</strong> sourced profiles</p><p><strong>{contributions}</strong> contributions</p><p><strong>14</strong> learning paths</p><a href="/about">A curated, growing collection <span aria-hidden="true">↗</span></a></div>
  <section class="home-section shell" aria-labelledby="doorway-title">
   <div class="home-section-heading"><div><p class="eyebrow">PICK A DIRECTION</p><h2 id="doorway-title">One curiosity. Many ways in.</h2></div><p>Read a story, follow an argument,<br/>or put an idea to the test.</p></div>
   <div class="home-doorways">{doorways.map(item => <a href={item.href} class={`home-doorway home-doorway-${item.number}`}><div class="doorway-top"><span class="eyebrow">{item.number} / {item.label}</span><span class="doorway-icon" aria-hidden="true">{item.icon}</span></div><h3>{item.title}</h3><p>{item.text}</p><div class="doorway-bottom"><span>{item.detail}</span><span aria-hidden="true">↗</span></div></a>)}</div>
  </section>
  <section class="home-section shell" aria-labelledby="ai-title"><div class="home-next"><div><p class="eyebrow">NEW / MODERN DISCOVERIES & AI</p><h2 id="ai-title">The ideas behind<br/>the intelligent machine.</h2><p>Explore transformers, generative models, human feedback, and AI for science. Twelve detailed articles explain the mechanisms, research teams, evidence, and limits.</p></div><nav aria-label="Modern discoveries"><a href="/innovations"><span>Explore all 12 discoveries</span>↗</a><a href="/innovations/transformer"><span>How transformers connect ideas</span>↗</a><a href="/innovations/alphafold-3"><span>Predicting molecular structures</span>↗</a></nav></div></section>
  <section class="home-section shell" aria-labelledby="people-title">
   <div class="home-section-heading"><div><p class="eyebrow">THE PEOPLE BEHIND THE IDEAS</p><h2 id="people-title">Extraordinary minds.<br/>Human stories.</h2></div><a href="/explore" class="home-section-link">Meet all {people.length} minds <span aria-hidden="true">↗</span></a></div>
   <div class="home-people-grid">{spotlight.map(person => person && <PersonCard person={person}/>)}</div>
  </section>
  <section class="home-section home-cosmos shell" aria-labelledby="cosmos-title">
   <div class="home-section-heading"><div><p class="eyebrow">A LITTLE PERSPECTIVE</p><h2 id="cosmos-title">Your place in the bigger picture.</h2></div><p>Choose a planet. Speed up time.<br/>Watch a familiar world differently.</p></div>
   <SolarSystem client:load />
  </section>
  <section class="home-section shell" aria-labelledby="try-title">
   <div class="home-section-heading"><div><p class="eyebrow">LEARN BY DOING</p><h2 id="try-title">Less memorising. More discovering.</h2></div><a href="/laboratory" class="home-section-link">All experiences <span aria-hidden="true">↗</span></a></div>
   <div class="home-experiments"><a href="/lab/gold-foil"><span class="eyebrow">EXPERIMENT / ATOMIC STRUCTURE</span><div class="experiment-art" aria-hidden="true"><span>α</span><i>→</i><b>│</b><i>↗</i></div><h3>Look inside the atom.</h3><p>Reconstruct Rutherford’s gold-foil experiment and see why a tiny nucleus changed the picture.</p><span class="home-section-link">Try the experiment ↗</span></a><a href="/topics/quantum-computing#playground"><span class="eyebrow">PLAYGROUND / QUANTUM COMPUTING</span><div class="experiment-art quantum-art" aria-hidden="true"><span>H</span><i>─</i><span>⊕</span><i>─</i><span>?</span></div><h3>A different kind of computer.</h3><p>Build a two-qubit circuit. Explore probability, interference, and the correlations of entanglement.</p><span class="home-section-link">Build a circuit ↗</span></a></div>
  </section>
  <section class="home-section shell"><div class="home-next"><div><p class="eyebrow">MAKE IT YOUR OWN</p><h2>Curiosity doesn’t have to<br/>follow a straight line.</h2><p>Follow connected ideas through a learning path, explore their history, or keep a collection of your own.</p></div><nav aria-label="Continue your learning"><a href="/paths"><span>Find a learning path</span>↗</a><a href="/timeline"><span>Explore the timeline</span>↗</a><a href="/collection"><span>Open your collection</span>↗</a></nav></div></section>
 </div>
</Base>
