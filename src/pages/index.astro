---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import SolarSystem from '../components/SolarSystem';
import { allPeople, verifyLinks, interactiveCount } from '../lib/people';
import { verifyArguments } from '../arguments/kernel/registry';
await verifyLinks(); await verifyArguments();
const people = await allPeople();
const interactive = await interactiveCount();
const spotlight = ['marie-curie', 'j-robert-oppenheimer', 'mary-wollstonecraft', 'br-ambedkar'].map(id => people.find(p => p.id === id)).filter(Boolean);
const fields = new Set(people.flatMap(p => p.data.fields));
---
<Base title="The Pantheon" description="Meet the minds that changed the world. Explore science and philosophy through sourced stories, interactive experiments, and ideas you can take apart.">
  <section class="home-hero solar-home shell">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-star">✳</span> AN ATLAS OF HUMAN CURIOSITY</p><h1 data-hi="Bade sawaal. Naye nazariye.">Great minds.<br/><em>World-changing ideas.</em></h1><p class="hero-description" data-hi="Duniya kaise kaam karti hai? Hum kya jaan sakte hain? Sochne walon se milo, discoveries samjho aur khud experiments karke dekho.">Follow the questions that changed everything.<br class="desktop-break"/> Meet the people. Understand the discoveries.<br class="desktop-break"/> Then try the ideas for yourself.</p><div class="hero-actions"><a href="/explore" class="button primary" data-hi="Minds aur ideas khojo ↗">Explore the minds <span>↗</span></a><a href="/laboratory" class="button text-button"><span class="play-outline">▷</span> Step into the lab</a></div><div class="hero-footnote"><span class="short-line"></span> A little curiosity can change your whole perspective.</div></div>
    <SolarSystem client:load />
  </section>
  <section class="stats-strip shell" aria-label="Inside the archive"><div><strong>{String(people.length).padStart(2,'0')}</strong><span>remarkable minds</span></div><div><strong>{String(interactive).padStart(2,'0')}</strong><span>interactive discoveries</span></div><div><strong>{fields.size}</strong><span>fields of thought</span></div><div class="stats-message"><span class="tiny-star">✳</span><span>Across cultures.<br/>Across centuries.</span></div></section>
  <section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">TWO WAYS OF ASKING WHY</p><h2>A growing world of ideas.</h2></div></div><div class="wing-grid">
    <a href="/scientists" class="wing-card science-card"><div class="wing-art" aria-hidden="true">◎</div><span class="eyebrow">01 / THE SCIENCE WING</span><h3>How does the<br/>world work?</h3><p>From the smallest particles to the farthest stars. Explore the experiments that made the invisible understandable.</p><div class="wing-card-bottom"><span>{people.filter(p=>p.data.category==='scientist').length} scientists · Discover & experiment</span><span>↗</span></div></a>
    <a href="/philosophers" class="wing-card philosophy-card"><div class="wing-art" aria-hidden="true">∞</div><span class="eyebrow">02 / THE PHILOSOPHY WING</span><h3>What does it mean<br/>to be human?</h3><p>Knowledge, existence, and how we ought to live. Follow the reasoning, challenge a premise, and see what still stands.</p><div class="wing-card-bottom"><span>{people.filter(p=>p.data.category==='philosopher').length} philosophers · Question & reflect</span><span>↗</span></div></a>
  </div></section>
  <section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">MEET YOUR NEXT BIG IDEA</p><h2>Extraordinary minds. Human stories.</h2></div><a href="/discoveries" class="inline-link">Explore discoveries & ideas ↗</a></div><div class="people-grid">{spotlight.map(person => person && <PersonCard person={person}/>)}</div></section>
  <section class="shell section-space"><div class="lab-banner"><div><p class="eyebrow">LESS MEMORISING. MORE DISCOVERING.</p><h2>Don’t just read about it.<br/><em>Make it happen.</em></h2><p>Change a variable. Test a prediction. Watch what follows.<br/>Our interactive lab puts the ideas in your hands.</p><a href="/laboratory" class="button primary">Enter the laboratory ↗</a></div><div class="lab-banner-list"><a href="/lab/orbit"><span>01</span><div><strong>Launch a planet</strong><small>Gravity & orbital mechanics</small></div>↗</a><a href="/lab/gold-foil"><span>02</span><div><strong>Look inside the atom</strong><small>Reconstruct Rutherford’s experiment</small></div>↗</a><a href="/p/rene-descartes#discovery-1"><span>03</span><div><strong>Try doubting everything</strong><small>Take apart Descartes’s argument</small></div>↗</a></div></div></section>
  <section class="shell section-space"><a href="/topics" class="quantum-feature"><div><p class="eyebrow">NEW / THE SCIENCE ATLAS</p><h2>What happens when<br/>a computer goes quantum?</h2><p>Six topic guides connect the big ideas.<br/>Start with a hands-on quantum circuit playground.</p><span class="button primary">Explore science topics ↗</span></div><div class="quantum-feature-art" aria-hidden="true"><span>H</span><i>─</i><span>⊕</span><small>|00⟩ + |11⟩<br/>──────────<br/>√2</small></div></a></section>
  <section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">FOLLOW YOUR CURIOSITY</p><h2>Every idea leads somewhere.</h2></div></div><div class="journey-grid"><a href="/paths" class="journey-card"><span class="journey-icon">⌁</span><h3>Take a learning path</h3><p>Connected ideas, in an order that makes sense. Start with a question and follow it deeper.</p><span class="inline-link">Find your starting point ↗</span></a><a href="/timeline" class="journey-card"><span class="journey-icon">↔</span><h3>Travel through time</h3><p>See how discoveries and arguments unfolded across centuries and cultures.</p><span class="inline-link">Explore the timeline ↗</span></a><a href="/collection" class="journey-card"><span class="journey-icon">▧</span><h3>Build your own collection</h3><p>Save fascinating people, keep your notes, and pick up where your curiosity left off.</p><span class="inline-link">Open your collection ↗</span></a></div></section>
</Base>
