---
import Base from '../layouts/Base.astro';
import { LABS } from '../data/learning';
import { allPeople } from '../lib/people';
const people = await allPeople();
const argumentsList = people.flatMap(p=>p.data.discoveries.flatMap((d,i)=>d.argument?[{person:p,title:d.title,index:i}]:[]));
---
<Base title="Laboratory" description="Explore physics through live experiments and a quantum circuit playground, and philosophy through interactive argument maps."><section class="shell page-intro"><p class="eyebrow">THE LABORATORY</p><h1>Ideas are better<br/>when you can <em>play with them.</em></h1><p>Make a prediction. Change a parameter. Follow the result. Every experiment includes a guide, a question to test your intuition, and an explanation of what the model leaves out.</p></section><section class="shell"><div class="section-heading"><h2>Explore the physical world</h2><span class="eyebrow">{LABS.length+3} EXPERIMENTS</span></div><div class="lab-grid"><a class="experiment-card" href="/lab/matter-and-sound#matter"><div class="experiment-art"><span>⚛</span><span class="experiment-mode">New · Animated explanation</span></div><div class="experiment-copy"><p class="eyebrow">Atoms & contact</p><h2>Why solids resist overlap ↗</h2><p>Bring two surfaces closer. Explore electron distributions, energy, and quantum exclusion.</p></div></a><a class="experiment-card" href="/lab/matter-and-sound#sound"><div class="experiment-art"><span>♫</span><span class="experiment-mode">New · Playable audio</span></div><div class="experiment-copy"><p class="eyebrow">Electronic music</p><h2>From signal to sensation ↗</h2><p>Change pitch and harmonics, play a phrase, and track air molecules in a pressure wave.</p></div></a><a class="experiment-card" href="/topics/quantum-computing#playground"><div class="experiment-art"><span>|ψ⟩</span><span class="experiment-mode">New · Circuit sandbox</span></div><div class="experiment-copy"><p class="eyebrow">Quantum computing</p><h2>Build a quantum circuit ↗</h2><p>Make a Bell pair, change a phase, and measure the result in a live two-qubit simulator.</p></div></a>{LABS.map(lab=><a class="experiment-card" href={`/lab/${lab.id}`}><div class="experiment-art"><span>{lab.symbol}</span><span class="experiment-mode">{lab.mode}</span></div><div class="experiment-copy"><p class="eyebrow">{lab.field}</p><h2>{lab.name} <span>↗</span></h2><p>{lab.description}</p></div></a>)}</div></section><section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">THE ARGUMENT ROOM</p><h2>What happens if you disagree?</h2></div></div><p class="text-muted mb-6 max-w-2xl text-sm leading-relaxed">Reject a premise and follow which conclusions lose their support. These maps expose the structure of a particular argument; they do not decide which beliefs are true.</p><div class="journey-grid">{argumentsList.map(a=><a class="journey-card" href={`/p/${a.person.id}#discovery-${a.index+1}`}><p class="eyebrow">{a.person.data.name}</p><h3>{a.title}</h3><p>{a.person.data.tagline}</p><span class="inline-link">Take apart the argument ↗</span></a>)}</div></section></Base>
