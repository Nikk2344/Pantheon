---
import Base from '../layouts/Base.astro';
import { allPeople } from '../lib/people';
import { chronologicalYear } from '../data/learning';
const people=await allPeople();
const events=people.flatMap(p=>p.data.discoveries.map((d,i)=>({person:p,discovery:d,index:i,year:chronologicalYear(d.year)}))).sort((a,b)=>a.year-b.year);
---
<Base title="Timeline" description="Explore a chronological atlas of discoveries and philosophical ideas across cultures."><section class="shell page-intro"><p class="eyebrow">IDEAS DON’T HAPPEN IN ISOLATION</p><h1>A long history of<br/><em>looking closer.</em></h1><p>Travel from ancient questions to modern discoveries. These are contributions represented in the current archive, not a complete history. Approximate dates and dates of publication are labelled as such.</p></section><section class="shell"><div class="timeline-toolbar"><label>Period<select id="timeline-era" class="filter-select"><option value="all">Across all time</option><option value="ancient">Before 500 CE</option><option value="medieval">500–1499</option><option value="early">1500–1799</option><option value="modern">1800 onwards</option></select></label><label>Discipline<select id="timeline-category" class="filter-select"><option value="all">Science & philosophy</option><option value="scientist">Science</option><option value="philosopher">Philosophy</option></select></label><p id="timeline-count" role="status">{events.length} ideas across time</p></div><ol class="global-timeline">{events.map(({person,discovery,index,year})=><li data-timeline-event data-year={year} data-category={person.data.category}><div class="timeline-year">{discovery.year}</div><div class="timeline-dot"></div><a href={`/p/${person.id}#discovery-${index+1}`} class="timeline-event"><div class="timeline-event-meta"><span class:list={['eyebrow',person.data.category==='scientist'?'text-science':'text-philosophy']}>{person.data.name}</span><span>{person.data.fields[0]}</span></div><h2>{discovery.title} <span>↗</span></h2><p>{discovery.summary}</p>{(discovery.interactiveDemo||discovery.argument)&&<span class="timeline-interactive">{discovery.argument?'◎ Interactive argument':'▷ Interactive experiment'}</span>}</a></li>)}</ol><div id="timeline-empty" class="empty-state" hidden>No entries in this period and discipline yet. Try another period.</div></section></Base>
<script>
const era=document.querySelector<HTMLSelectElement>('#timeline-era')!;const category=document.querySelector<HTMLSelectElement>('#timeline-category')!;
function update(){let count=0;document.querySelectorAll<HTMLElement>('[data-timeline-event]').forEach(e=>{const y=Number(e.dataset.year);const matches=era.value==='all'||era.value==='ancient'&&y<500||era.value==='medieval'&&y>=500&&y<1500||era.value==='early'&&y>=1500&&y<1800||era.value==='modern'&&y>=1800;e.hidden=!(matches&&(category.value==='all'||e.dataset.category===category.value));if(!e.hidden)count++;});document.getElementById('timeline-count')!.textContent=`${count} ideas across time`;document.getElementById('timeline-empty')!.hidden=count>0;}
era.addEventListener('change',update);category.addEventListener('change',update);
</script>
