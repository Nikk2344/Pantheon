---
import Base from '../../layouts/Base.astro';
import { TOPICS } from '../../data/topics';
---
<Base title="Science topics" description="Explore quantum computing, quantum mechanics, relativity, evolution, and the ideas that connect them." wing="wing-science">
 <section class="shell page-intro"><p class="eyebrow">THE SCIENCE ATLAS / {TOPICS.length} GUIDES</p><h1>Start with a question.<br/><em>Explore a whole field.</em></h1><p>Go beyond a single biography. Build a foundation, untangle a misconception, and try the ideas yourself.</p></section>
 <section class="shell"><a href="/topics/quantum-computing#playground" class="quantum-feature"><div><p class="eyebrow">NEW · INTERACTIVE QUANTUM LAB</p><h2>Two qubits.<br/>A world of possibilities.</h2><p>Build a Bell pair. Change a phase. Measure the result.<br/>Your first quantum circuit starts here.</p><span class="button primary">Build a circuit ↗</span></div><div class="quantum-feature-art" aria-hidden="true"><span>H</span><i>─</i><span>⊕</span><small>|00⟩ + |11⟩<br/>──────────<br/>√2</small></div></a></section>
 <section class="shell section-space"><a class="atlas-feature" href="/lab/matter-and-sound"><div><p class="eyebrow">NEW · MATTER & MUSIC</p><h2>Touch a surface.<br/>Hear a moving world.</h2><p>Two interactive animations connect atomic interactions with solid objects and electronic sound.</p><span class="inline-link">Explore matter and music ↗</span></div><div class="atlas-feature-symbol" aria-hidden="true">∿</div></a></section><section class="shell section-space"><div class="section-heading"><h2>Find your next question.</h2><span class="eyebrow">NO ADVANCED MATH REQUIRED</span></div><div class="topic-grid">{TOPICS.map((t,i)=><a class="topic-card" href={`/topics/${t.id}`}><div class="topic-card-top"><span class="eyebrow">{String(i+1).padStart(2,'0')} / SCIENCE</span><span class="topic-symbol" aria-hidden="true">{t.symbol}</span></div><h2>{t.title}</h2><p>{t.description}</p><div class="topic-card-bottom"><span>{t.minutes} min · {t.id==='quantum-computing'?'Circuit playground':'Guided introduction'}</span><span>↗</span></div></a>)}</div></section>
</Base>
