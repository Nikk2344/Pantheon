---
import Base from '../../../layouts/Base.astro';
import {TRADITIONS,type Tradition} from '../../../data/traditions';
import {SCHOOLS} from '../../../data/schools';
export function getStaticPaths(){return TRADITIONS.map(t=>({params:{id:t.id},props:{t}}));}
interface Props{t:Tradition}
const {t}=Astro.props;
---
<Base title={t.name} description={t.essence} wing="wing-philosophy"><section class="shell page-intro"><a class="inline-link" href="/philosophy#traditions">← Cultural traditions</a><p class="eyebrow topic-kicker">{t.region} / INTRODUCTION</p><h1>{t.name}</h1><p>{t.essence}</p></section><div class="shell atlas-reading"><aside class="atlas-question-panel"><p class="eyebrow">KEEP THE DIFFERENCES IN VIEW</p><p>{t.debates}</p></aside><section><h2>Texts & entry points</h2><div class="text-guide-list">{t.texts.map(([name,text])=><article><h3>{name}</h3><p>{text}</p></article>)}</div></section>{t.id==='hindu'&&<><a class="atlas-feature" href="/philosophy/texts"><div><p class="eyebrow">THE TEXTS, IN ESSENCE</p><h2>Begin with the Vedas.<br/>Follow the questions.</h2><p>Four Vedas, principal Upanishads, the Gītā, and foundational philosophical works.</p><span class="inline-link">Open the text guide ↗</span></div></a><section><h2>Shared words, contested meanings</h2><dl class="atlas-glossary"><dt>Ātman</dt><dd>Self; its nature and relation to consciousness are disputed.</dd><dt>Brahman</dt><dd>Ultimate reality in many Upanishadic and Vedānta contexts; not the same word as Brahmā, the deity.</dd><dt>Dharma</dt><dd>A context-sensitive term including duty, norm, and right conduct; no one English word captures every use.</dd><dt>Karma</dt><dd>Action and its consequences within different ethical and cosmological accounts; not a reason to blame suffering people.</dd><dt>Mokṣa</dt><dd>Liberation, explained differently across schools.</dd><dt>Pramāṇa</dt><dd>A means of valid knowledge. Schools debate which means are reliable and in which domains.</dd></dl></section></>}{t.schools.length>0&&<section><h2>Explore the schools</h2><div class="atlas-grid">{t.schools.map(id=>{const s=SCHOOLS.find(s=>s.id===id)!;return <a class="atlas-card" href={`/philosophy/schools/${id}`}><h3>{s.name} ↗</h3><p>{s.essence}</p></a>;})}</div></section>}<section><h2>Source & further study</h2><a class="inline-link" href={t.source}>Read the reference introduction ↗</a><p>These short guides are an orientation to study. They do not replace primary texts, their interpretive traditions, or the voices of living communities.</p></section></div></Base>
