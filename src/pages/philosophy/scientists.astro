---
import Base from '../../layouts/Base.astro';
import {SCIENTIST_VIEWS} from '../../data/scientist-views';
import {allPeople} from '../../lib/people';
const people=(await allPeople()).filter(p=>p.data.category==='scientist');
for(const p of people)if(!SCIENTIST_VIEWS[p.id])throw new Error(`Missing scientist outlook: ${p.id}`);
const kinds=['Documented outlook','Methodological position','Limits of the record'];
---
<Base title="Scientists & philosophical outlooks" description="Read scientists’ documented views and research approaches alongside their discoveries, with sources and limits." wing="wing-philosophy"><section class="shell page-intro"><a class="inline-link" href="/philosophy">← Philosophy atlas</a><p class="eyebrow topic-kicker">SCIENCE MEETS PHILOSOPHY / {people.length} PROFILES</p><h1>The discovery.<br/><em>The person’s wider questions.</em></h1><p>Scientists disagree about knowledge, reality, faith, beauty, and responsibility. A successful discovery does not prove every belief of the person who made it.</p><nav class="atlas-jumps" aria-label="Evidence categories">{kinds.map((k,i)=><a href={`#evidence-${i}`}>{k} ↓</a>)}</nav></section><section class="shell atlas-reading"><div class="atlas-question-panel"><h2>How to read these entries</h2><p><strong>Documented outlook</strong> summarizes stated views or established biographical evidence. <strong>Methodological position</strong> explains a research approach; it is not a declaration of the person’s complete worldview. <strong>Limits of the record</strong> makes missing or uncertain attribution explicit.</p></div></section>{kinds.map((kind,i)=><section class="shell section-space" id={`evidence-${i}`}><div class="section-heading"><h2>{kind}</h2></div><div class="atlas-grid">{people.filter(p=>SCIENTIST_VIEWS[p.id].kind===kind).map(p=>{const v=SCIENTIST_VIEWS[p.id];return <a class="atlas-card" href={`/p/${p.id}#philosophy`}><span class="eyebrow">{p.data.name}</span><h3>{v.title} ↗</h3><p>{v.view}</p><span class="atlas-question">Read alongside {p.data.discoveries[0].title.toLowerCase()} →</span></a>;})}</div></section>)}</Base>
