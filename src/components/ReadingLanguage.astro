---
import { KEYS, LANGUAGES, STRINGS } from '../data/i18n';
const dictionary = Object.fromEntries(LANGUAGES.map((l) => [l.code, Object.fromEntries(KEYS.map((k, i) => [k, STRINGS[l.code]![i]]))]));
const languageMeta = Object.fromEntries(LANGUAGES.map((l) => [l.code, { rtl: !!l.rtl, google: l.google ?? l.code }]));
---
<div class="reading-language shell" data-reading-language>
 <span data-hi="Apni language chuno" data-i18n="lang.reading">Reading language</span>
 <button type="button" data-language-choice="en" aria-pressed="true">English</button>
 <button type="button" data-language-choice="hinglish" aria-pressed="false">Hinglish</button>
 <details class="other-languages"><summary>More languages</summary><div class="language-popover"><label for="translate-language">Interface language</label><select id="translate-language">{LANGUAGES.map((l) => <option value={l.code}>{l.native} · {l.english}</option>)}</select><a id="translate-page" href="https://translate.google.com/" target="_blank" rel="noreferrer">Open Google Translate ↗</a><script type="application/json" id="i18n-data" set:html={JSON.stringify({ dictionary, languageMeta })}></script><p id="translation-note">Machine translation may change technical meanings. Check the English original and cited sources.</p><p>The menus and homepage are translated into {LANGUAGES.length} languages. Biographies, books, and arguments are still in English; use the link above for a machine translation of the whole page. Hinglish is Roman Hindi with English terms.</p></div></details>
 <span class="language-coverage" hidden data-hinglish-note lang="hi-Latn">Hinglish guide · baaki articles abhi English mein hain.</span>
</div>
<script>
 const root=document.querySelector<HTMLElement>('[data-reading-language]');
 const originals=new WeakMap<HTMLElement,string>();
 const data=JSON.parse(document.getElementById('i18n-data')?.textContent??'{"dictionary":{},"languageMeta":{}}') as {dictionary:Record<string,Record<string,string>>;languageMeta:Record<string,{rtl:boolean;google:string}>};
 const select=document.querySelector<HTMLSelectElement>('#translate-language'),link=document.querySelector<HTMLAnchorElement>('#translate-page'),note=document.querySelector<HTMLElement>('#translation-note');
 function applyLanguage(value:string){
  const hi=value==='hinglish',dict=data.dictionary[value];
  const all=document.querySelectorAll<HTMLElement>('[data-hi],[data-i18n]');
  all.forEach(el=>{if(!originals.has(el))originals.set(el,el.innerHTML);});
  all.forEach(el=>{el.innerHTML=originals.get(el)??el.innerHTML;el.removeAttribute('lang');});
  document.documentElement.dataset.language=hi?'hinglish':dict?value:'en';
  document.documentElement.lang=hi?'hi-Latn':dict?value:'en';
  document.documentElement.dir=dict&&data.languageMeta[value]?.rtl?'rtl':'ltr';
  if(hi)document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{el.textContent=el.dataset.hi??'';el.lang='hi-Latn';});
  else if(dict)document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el=>{const t=dict[el.dataset.i18n??''];if(t){el.textContent=t;el.lang=value;}});
  root?.querySelectorAll<HTMLButtonElement>('[data-language-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.languageChoice===(dict?'':value))));
  if(select&&dict)select.value=value;
  const hn=root?.querySelector<HTMLElement>('[data-hinglish-note]');if(hn)hn.hidden=!hi;
  try{localStorage.setItem('pantheon-language',value);}catch{}
  updateTranslation();
  document.dispatchEvent(new Event('pantheon-language'));
 }
 function updateTranslation(){if(!select||!link||!note)return;const local=['localhost','127.0.0.1','[::1]'].includes(location.hostname)||location.hostname.endsWith('.local');
  if(local){link.href='https://support.google.com/chrome/answer/173424';link.textContent='How to use browser translation ↗';note.textContent='This is a local preview. Use your browser’s Translate command for this page. Website translation links become available after public hosting.';}
  else{const url=new URL('https://translate.google.com/translate');url.searchParams.set('sl','en');url.searchParams.set('tl',data.languageMeta[select.value]?.google??select.value);url.searchParams.set('u',location.origin+location.pathname);link.href=url.toString();link.textContent='Translate this page with Google ↗';note.textContent='Opens an external service with this public page URL. Machine translation can change technical meanings; compare with the original.';}}
 let saved='en';try{saved=localStorage.getItem('pantheon-language')||'en';}catch{}
 if(saved!=='hinglish'&&!data.dictionary[saved])saved='en';
 applyLanguage(saved);
 root?.querySelectorAll<HTMLButtonElement>('[data-language-choice]').forEach(b=>b.addEventListener('click',()=>applyLanguage(b.dataset.languageChoice??'en')));
 select?.addEventListener('change',()=>{updateTranslation();applyLanguage(select.value);});
</script>
<style>
 .reading-language{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-top:12px;padding-bottom:12px;font-size:11px;border-bottom:1px solid var(--tk-border);position:relative;z-index:5}.reading-language>span:first-child{color:var(--tk-muted);margin-right:4px}.reading-language button,.other-languages summary{font:inherit;border:1px solid var(--tk-border);padding:6px 10px;border-radius:20px;background:var(--tk-surface);color:var(--tk-ink);cursor:pointer}.reading-language button[aria-pressed=true]{border-color:var(--tk-accent);color:var(--tk-accent)}.other-languages summary{list-style:none}.other-languages{position:relative}.language-popover{position:absolute;top:35px;left:0;width:min(320px,80vw);padding:20px;background:var(--tk-surface);border:1px solid var(--tk-border-strong);box-shadow:0 16px 40px #0004;border-radius:14px;font-size:12px;line-height:1.7}.language-popover label,.language-popover select,.language-popover a{display:block;margin-bottom:12px}.language-popover select{width:100%;padding:9px;background:var(--tk-raised);color:var(--tk-ink);border:1px solid var(--tk-border);border-radius:7px}.language-popover p{color:var(--tk-muted)}.language-coverage{color:var(--tk-muted);margin-left:auto}.reading-language [hidden]{display:none}@media(max-width:650px){.language-coverage{width:100%;margin-left:0}.language-popover{left:auto;right:0}.reading-language{font-size:10px}}
</style>
