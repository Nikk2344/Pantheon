<script>
  const motion = document.getElementById('orbit-motion');
  const track = document.querySelector<HTMLElement>('.orbit-track');
  if (motion && track) { let paused = matchMedia('(prefers-reduced-motion: reduce)').matches; const sync = () => { track.style.animationPlayState = paused ? 'paused' : 'running'; motion.textContent = paused ? 'Play motion' : 'Pause motion'; motion.setAttribute('aria-pressed', String(paused)); }; sync(); motion.addEventListener('click', () => { paused = !paused; sync(); }); }
