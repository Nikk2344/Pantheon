---
import { Image } from 'astro:assets';
import { lifespan, portraitFor, type Person } from '../lib/people';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const p = portraitFor(person.id);
const interactives = person.data.discoveries.filter((d) => d.interactiveDemo || d.argument).length;
---

<a
  href={`/p/${person.id}`}
  class="person-card group relative flex flex-col overflow-hidden rounded-token border border-line bg-raised shadow-token transition duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lift"
>
  <div class="portrait-wrap relative aspect-4/5 overflow-hidden bg-surface">
    {
      p ? (
        <Image
          src={p.image}
          width={560}
          alt={`Portrait of ${person.data.name}`}
          widths={[280, 560]}
          sizes="(min-width: 1024px) 280px, (min-width: 640px) 33vw, 90vw"
          class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
          loading="lazy"
        />
      ) : (
        <div class="portrait-placeholder" aria-label="No portrait available">
          <span>{person.data.name.split(' ').map(n=>n[0]).slice(0,2).join('')}</span><small>THE PANTHEON ARCHIVE</small>
        </div>
      )
    }

    {
      interactives > 0 && (
        <span class="absolute right-2.5 top-2.5 flex items-center gap-1 rounded-full bg-black/65 px-2 py-1 text-[10px] font-semibold text-white backdrop-blur-sm">
          <svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M0 1.4v9.2a1 1 0 0 0 1.5.86l7.7-4.6a1 1 0 0 0 0-1.72L1.5.54A1 1 0 0 0 0 1.4Z" fill="currentColor" />
          </svg>
          {interactives} interactive{interactives > 1 ? 's' : ''}
        </span>
      )
    }
  </div>

  <div class="person-body flex flex-1 flex-col gap-1.5 p-4">
    <div class="person-heading flex items-baseline justify-between gap-2">
      <h3 class="text-[15px] font-semibold leading-tight tracking-tight">
        {person.data.name}
      </h3>
      <span class="person-lifespan shrink-0 font-mono text-[11px] text-faint">{lifespan(person)}</span>
    </div>
    <p class="line-clamp-3 text-[13px] leading-relaxed text-muted">
      {person.data.tagline}
    </p>
    <div class="mt-auto flex flex-wrap gap-1.5 pt-2.5">
      {
        person.data.fields.slice(0, 3).map((f) => (
          <span class="rounded-md bg-surface px-1.5 py-0.5 text-[10px] font-medium text-faint">
            {f}
          </span>
        ))
      }
    </div>
  </div>
</a>
